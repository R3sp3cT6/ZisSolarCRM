    "server-only": "0.0.1",
    "shadcn": "4.18.0",
    "suncalc": "^2.0.2",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
